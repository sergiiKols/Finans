@echo off
chcp 65001 >nul
title Кабинет семейного учёта — для домашней сети
cd /d "%~dp0"

echo Кабинет будет доступен телефонам в домашней сети.
echo Windows спросит разрешение брандмауэра — ответить "Разрешить доступ"
echo и обязательно оставить галочку "Частные сети".
echo.
ipconfig | findstr /i "IPv4"
echo Заходить с телефона по адресу выше, порт 8090. Например: http://192.168.1.50:8090
echo.
python server.py --port 8090 --host 0.0.0.0
pause
